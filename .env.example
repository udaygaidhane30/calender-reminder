# Twilio API Credentials
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio WhatsApp Number (sender)
# Format: +14155238886 (include country code, no spaces)
TWILIO_WHATSAPP_NUMBER=+14155238886

# Default recipient phone number (your number to receive reminders)
# Format: +1234567890 (include country code, no spaces)
DEFAULT_RECIPIENT_NUMBER=+1234567890

# Google Calendar Configuration
# The calendar ID to monitor (default: 'primary' for your main calendar)
# To use a specific calendar, find its Calendar ID in Google Calendar settings
# Format: calendar_id@group.calendar.google.com or just 'primary'
GOOGLE_CALENDAR_ID=primary

# Note: For GitHub Actions deployment, set these as GitHub Secrets instead
# See GITHUB_ACTIONS_SETUP.md for complete instructions
